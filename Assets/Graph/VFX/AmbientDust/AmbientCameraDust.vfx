  m_Script: {fileID: 11500000, guid: d01270efd3285ea4a9d6c555cb0a8027, type: 3}
  m_Name: VFXUI
  m_EditorClassIdentifier: 
  groupInfos: []
  stickyNoteInfos:
  - title: Spawn At Origin....
    position:
      serializedVersion: 2
      x: 1413
      y: 277
      width: 456
      height: 163
    contents: Particles are spawned around the 0,0,0 origin of the worlk
    theme: 
    textSize: Medium
    colorTheme: 1
  - title: ... then Tile/Warp positions
    position:
      serializedVersion: 2
      x: 1426
      y: 1714
      width: 671
      height: 337
    contents: "Even though the particles are simulated in a volume at origin, the
      Tile / Warp node makes particles tile infinitely across the space, based on
      a AABox of a given size. \n\nHere, we use the same size as the initial spawn
      volume. This ensures we have consistent floating dust across all the scene."
    theme: 
    textSize: Medium
    colorTheme: 1
  categories: []
  uiBounds:
    serializedVersion: 2
    x: 509
    y: -185
    width: 1588
    height: 2964
